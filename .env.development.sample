# Copy to `.env.development` and fill in. Shared dev/staging environment.
NODE_ENV=development
PORT=8080

# Point at the shared dev database (managed instance, not local docker).
DATABASE_URL=postgresql://<user>:<password>@<dev-host>:5432/kairos_db

AWS_REGION=<region>
AWS_COGNITO_USER_POOL_ID=<pool-id>
AWS_COGNITO_CLIENT_ID=<client-id>

ALLOW_ORIGIN=https://dev.kairos.app
