NODE_ENV=development
PORT=8080

# Local Postgres via docker-compose (host port 5434 -> container 5432)
# Run `docker compose up -d` first, then this URL just works.
DATABASE_URL=postgresql://kairos:kairos@localhost:5434/kairos_db

# AWS Cognito — leave blank for now; required once the auth layer lands
AWS_REGION=
AWS_COGNITO_USER_POOL_ID=
AWS_COGNITO_CLIENT_ID=

ALLOW_ORIGIN=http://localhost:3000,http://localhost:3001
