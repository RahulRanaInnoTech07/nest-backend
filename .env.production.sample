# Copy to `.env.production` OR (preferred) inject these as host env vars.
# In production, real environment variables take precedence and a missing
# `.env.production` file is fine.
NODE_ENV=production
PORT=8080

DATABASE_URL=postgresql://<user>:<password>@<prod-host>:5432/kairos_db

AWS_REGION=<region>
AWS_COGNITO_USER_POOL_ID=<pool-id>
AWS_COGNITO_CLIENT_ID=<client-id>

ALLOW_ORIGIN=https://app.kairos.app
